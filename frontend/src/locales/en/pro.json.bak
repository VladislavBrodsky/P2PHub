  "faq": {
    "title": "FAQ",
    "items": {
      "q1": "Is this a one-time purchase?",
      "a1": "Yes. Current PRO and PRO+ deals are for lifetime access. No subscriptions, no hidden fees. Once you upgrade, you are a PRO member forever.",
      "q2": "How do I receive commissions?",
      "a2": "Commissions is automatically added to your balance whenever your structure grows or someone upgrades. You can withdraw to your USDT wallet at any time.",
      "q3": "What are Viral Studio Tokens?",
      "a3": "Tokens power our AI Viral Studio. Every post you generate or optimize consumes tokens. PRO+ partners get double tokens and priority AI queue access.",
      "q4": "Which plan is better for growing a team?",
      "a4": "If you are serious about building a global network, PRO+ is the only choice. 20 levels of depth captures 20x more volume than 9 levels.",
      "q5": "What is the Passive Income reach?",
      "a5": "It is our multi-level passive income system. When anyone in your structure makes a card transaction — you automatically receive a commission. PRO opens 9 levels deep, PRO+ — all 20 levels, which is 20x more passive income reach.",
      "q6": "How much faster will my team grow with PRO?",
      "a6": "PRO partners consistently grow their networks 5-10x faster using only the Viral Studio. Add the Growth Intelligence tools and OMNI-Sync publishing — and PRO+ partners report 100x faster team scaling compared to free members.",
      "q7": "Can I upgrade from PRO to PRO+ later?",
      "a7": "Yes. You can upgrade at any time from the app. Your current PRO period is credited towards the PRO+ upgrade price. Upgrading sooner means more passive income while the price is still at the current level.",
      "view_faq_center": "OPEN FULL FAQ CENTER",
      "badge": "SUPPORT",
      "title": "KNOWLEDGE BASE",
      "desc": "Everything you need to know about PRO status."
    }
  }
