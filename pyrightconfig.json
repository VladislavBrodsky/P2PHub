{
  "include": [
    "backend",
    "frontend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "venv",
    ".venv",
    ".venv_new"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "venvPath": ".",
      "venv": ".venv",
      "extraPaths": [
        "."
      ]
    }
  ],
  "typeCheckingMode": "basic"
}
