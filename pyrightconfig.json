{
  "include": [
    "backend",
    "frontend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "venv",
    ".venv",
    ".venv_new"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "venvPath": "/tmp",
      "venv": "p2phub-venv"
    }
  ],
  "typeCheckingMode": "basic"
}
